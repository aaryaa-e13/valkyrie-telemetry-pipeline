# Copy to .env to override defaults (`make env` does this for you).
# .env is git-ignored. No secrets are needed in Phase 1.

# --- Kafka ---
KAFKA_IMAGE=apache/kafka:4.3.2
KAFKA_HOST_PORT=9092
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
KAFKA_HEAP_OPTS=-Xms512m -Xmx512m
KAFKA_MEM_LIMIT=1g

# --- Topic ---
TOPIC_NAME=game-events
TOPIC_PARTITIONS=6
TOPIC_REPLICATION_FACTOR=1
TOPIC_RETENTION_MS=604800000
